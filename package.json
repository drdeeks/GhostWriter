    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.4.5",
    "viem": "^2.51.3",
    "wagmi": "2.16.0"
  },
