{
  "name": "ghost-writer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "ts-check": "tsc --noEmit",
    "test": "npm run test:frontend && npm run test:contracts",
    "test:gas": "REPORT_GAS=true npx hardhat test",
    "test:coverage": "hardhat coverage --solcoverjs .solcover.js",
    "test:frontend": "jest --detectOpenHandles --forceExit",
    "test:nft": "jest --detectOpenHandles --forceExit -c jest.config.nft.js",
    "test:frontend:watch": "jest --watch",
    "test:frontend:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "test:contracts": "npx hardhat test",
    "test:all": "npm run test:frontend && npm run test:contracts",
    "test:ci": "npm run ts-check && npm run test:coverage && npm run test:frontend:coverage",
    "test:integration": "jest --config jest.integration.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "compile": "hardhat compile",
    "deploy:baseSepolia": "node scripts/deploy-with-prompt.js baseSepolia",
    "deploy:base": "node scripts/deploy-with-prompt.js base",
    "deploy:monadTestnet": "hardhat run scripts/deploy.js --network monadTestnet",
    "deploy:monad": "hardhat run scripts/deploy.js --network monad",
    "deploy:modeSepolia": "hardhat run scripts/deploy.js --network modeSepolia",
    "deploy:mode": "hardhat run scripts/deploy.js --network mode",
    "deploy:localhost": "hardhat run scripts/deploy.js --network localhost",
    "verify": "node scripts/verify.js",
    "node": "hardhat node",
    "keystore": "node scripts/keystore-manager.js",
    "keystore:create": "node scripts/keystore-manager.js create",
    "keystore:import": "node scripts/keystore-manager.js import",
    "keystore:list": "node scripts/keystore-manager.js list",
    "keystore:test": "node scripts/keystore-manager.js test",
    "validate:env": "node scripts/validate-env.js",
    "check:dependencies": "node scripts/check-dependencies.js",
    "rollback:contracts": "node scripts/rollback-contracts.js",
    "predeploy": "npm run validate:env && npm run check:dependencies",
    "postdeploy": "echo 'Deployment completed. Verify all checklist items before marking as complete.'"
  },
