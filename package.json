    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "ethers": "^6.12.1",
    "hardhat": "^2.22.6",
    "hardhat-gas-reporter": "^1.0.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-fetch-mock": "^3.0.3",
    "solidity-coverage": "^0.8.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typechain": "^8.3.2",
    "undici": "^6.28.0",
    "util": "^0.12.5",
    "wrangler": "^4.118.0"
